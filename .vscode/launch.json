{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "prepare_bp4d (smoke)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/code",
            "program": "${workspaceFolder}/code/data/prepare_bp4d.py",
            "args": [
                "--raw_root", "${workspaceFolder}/data/raw/BP4D",
                "--out_root", "${workspaceFolder}/data/processed/bp4d_canonical",
                "--limit_sessions", "2",
                "--images", "copy"
            ],
            "env": {
                "DATA_PATH": "${workspaceFolder}/data/processed/bp4d_canonical",
                "RAW_DATA_PATH": "${workspaceFolder}/data/raw/BP4D"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "run_pretrain (stage2 local)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/code",
            "program": "${workspaceFolder}/code/runners/run_pretrain.py",
            "args": [
                "-c", "configs/pretrain/stage2_local.yaml"
            ],
            "env": {
                "DATA_PATH": "${workspaceFolder}/data/processed/bp4d_canonical",
                "OUTPUT_DIR": "${workspaceFolder}/output"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "run_pretrain (stage2 local rgb_roi bp)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/code",
            "program": "${workspaceFolder}/code/runners/run_pretrain.py",
            "args": [
                "-c", "configs/pretrain/stage2_local_rgb_roi_bp.yaml"
            ],
            "env": {
                "RAW_DATA_PATH": "${workspaceFolder}/data/raw/BP4D",
                "OUTPUT_DIR": "${workspaceFolder}/output"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "run_pretrain (stage2 local rgb_roi bp SMOKE)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/code",
            "program": "${workspaceFolder}/code/runners/run_pretrain.py",
            "args": [
                "-c", "configs/pretrain/stage2_local_rgb_roi_bp.yaml",
                "--epochs", "1", "--warmup_epochs", "0",
                "--max_entries", "2", "--num_workers", "0",
                "--output_dir", "/tmp/rgb_roi_bp_smoke"
            ],
            "env": {
                "RAW_DATA_PATH": "${workspaceFolder}/data/raw/BP4D",
                "OUTPUT_DIR": "${workspaceFolder}/output"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "inspect rgb_roi (list sessions)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/code",
            "program": "${workspaceFolder}/code/data/rgb_roi_dataset.py",
            "args": [
                "--list"
            ],
            "env": {
                "RAW_DATA_PATH": "${workspaceFolder}/data/raw/BP4D",
                "OUTPUT_DIR": "${workspaceFolder}/output"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
