-# Stage 2 -- LOCAL run: thermal ROI (visual) -> RESPIRATION (1-D target).
-#
-# ============================================================================
-# SOLUTION A variant ("Asymmetric Cross-MAE"): the asymmetric twin of
-# configs/pretrain/stage2_local_tir_roi_resp.yaml.
-#
-# Architecture spec:  code/notes/design/SolutionA_asymCrossMAE.md
-# Diagrams:           code/notes/design/SolutionA_asymCrossMAE_diagram.md
-#
-# It differs from the shared-encoder config (Solution C) in EXACTLY ONE STAGE --
-# the pre-training -- and in nothing else:
-#   * DATA IS IDENTICAL: same data_set / ROI / task selection / geometry /
-#     input_size. Every key is byte-copied from the Solution C config; only the
-#     four keys in the "Solution A" block below are added.
-#   * ENCODER INTERFACE IS IDENTICAL: the same adapters.tir / positions.tir /
-#     enc_blocks / enc_norm keys and shapes, so either pre-trained encoder loads
-#     into the SAME Stage-3 model (MultiModalWaveformRegressor, streams=tir).
-#   * ONLY THE PRE-TRAINING DIFFERS: resp_in_encoder false -> the encoder never
-#     sees a resp token, so it cannot satisfy the masked respiration target by
-#     interpolating its own visible samples; resp is instead decoded by a
-#     target-driven cross-attention head whose learned per-time-slot queries
-#     attend to the whole visual encoder output.
-#
-# Run from code/ (ALWAYS with `-u`: without it stdout is block-buffered through
-# `tee`, so an interrupted run leaves a log with NO epoch lines):
-#     python -u runners/run_pretrain.py -c configs/pretrain/stage2_local_tir_roi_crossmae.yaml \
-#         2>&1 | tee ../output/pretrain/stage2_local_tir_roi_crossmae/train.log
-# Smoke first (--warmup_epochs 0 is REQUIRED: epochs < warmup trips the
-# pre-existing cosine_scheduler assert in utils/lr_sched.py):
-#     python -u runners/run_pretrain.py -c configs/pretrain/stage2_local_tir_roi_crossmae.yaml \
-#         --epochs 1 --warmup_epochs 0 --max_entries 2 --num_workers 0 \
-#         --output_dir /tmp/tir_roi_crossmae_probe
-# ============================================================================
-#
-# ADD-ON experiment, procedure of record: code/notes/plan/TirROI_Resp_plan.md.
-# The counterpart of configs/pretrain/stage2_local_pretrained.yaml for the
-# thermal-only setting: the ONLY visual information is the mouth+nose ROI of the
-# thermal rendering, and the ONLY waveform is respiration.
-#
-# Nothing here affects the existing rgb,bp* runs -- they keep using
-# data_set: bp4d+ (PairedPretrainDataset). This file selects the new
-# data_set: tir_roi path, which reads the RAW tree (Thermal/, IRFeatures/,
-# Physiology/Resp_Volts.txt) because the ROI crop needs native-resolution frames
-# plus the 28-point landmark track. See the plan doc for why the canonical
-# layout cannot serve a clip-dependent ROI crop.
-#
-# The ROI is ONE static box per clip (min/max of the 12 landmark points over all
-# frames of the window + roi_padding), so the patch cannot jitter spatially.
-# A clip touching a (0,0) sentinel line (the undocumented "tracker lost the
-# face" marker) is dropped whole by the dataset.
-#
-# Init: the shared encoder blocks AND the tubelet tokenizer come from VideoMAE
-# ViT-B. With streams: tir,resp there is no rgb adapter, so
-# load_pretrained_encoder routes the checkpoint's Conv3d(3, 768, (2,16,16))
-# patch embed into adapters.tir VERBATIM (same 3 channels, same tubelet) -- the
-# temporal kernel is inherited verbatim.
-#
-# Run from code/ (ALWAYS with `-u`: without it stdout is block-buffered through
-# `tee`, so an interrupted run leaves a log with NO epoch lines):
-#     python -u runners/run_pretrain.py -c configs/pretrain/stage2_local_tir_roi_resp.yaml \
-#         2>&1 | tee ../output/pretrain/stage2_local_tir_roi_resp/train.log
-# Smoke first (--warmup_epochs 0 is REQUIRED: epochs < warmup trips the
-# pre-existing cosine_scheduler assert in utils/lr_sched.py):
-#     python -u runners/run_pretrain.py -c configs/pretrain/stage2_local_tir_roi_resp.yaml \
-#         --epochs 1 --warmup_epochs 0 --max_entries 2 --num_workers 0 \
-#         --output_dir /tmp/tir_roi_probe
-
-data_set: tir_roi
-# --raw_root defaults to $RAW_DATA_PATH (scripts/env_local.sh), else
-# <repo>/data/raw/BP4D. The local corpus is 40 thermal sessions (4 subjects x
-# T1..T10, 45 858 frames = 30.6 min); at 8 s / 4 s hop that is 388 clips.
-subjects: ''                       # '' = all; 'F001' to pin one subject
-pretrain_split: all                # Stage 2 always uses every selected subject/session
-tasks: ''                          # explicit task labels, '' = all;
-                                   #   UNIONED with task_set below
-# ---- task GROUPS ("distortion levels") ---------------------------------
-# Named subsets of the BP4D+ task labels (T1..T10). The DEFINITIONS live in the
-# config (not in code), so they can be edited per experiment, but the SHIPPED
-# tiers are pinned by code/data/task_groups.py::SHIPPED_TASK_GROUPS and by
-# tests/test_task_group_configs.py. The tasks differ in how much they disturb
-# the recordings (head motion / speech / pain), so a run can be restricted to
-# one level. Resolution (union with `tasks`, fail-fast on an unknown name) is in
-# code/data/task_groups.py; the selected level of every clip is recorded in
-# `entry['task_level']` and in the dataset stats.
-# v2 (2026-10-24): T5 high->low, T1 high->moderate, T10 moderate->high.
-# Rationale: code/notes/design/TIR_ROI_RESP_TasksDistortion.md.
-task_groups:
-  low: [T2, T3, T5]                # passive viewing + short yes/no answers
-  moderate: [T1, T4]               # laughter / facial expression + startle
-  high: [T6, T7, T8, T9, T10]      # singing, threat, pain, anger, disgust
-task_set: ''                       # '' = all tasks; 'low' or 'low,high'
-                                   #   (union of groups). CLI: --task_set
-
-model: project_multimae_base       # 768-d/12-layer -- MUST match pretrained_encoder
-pretrained_encoder: videomae:k400  # VideoMAE ViT-B corpus: k400 (Kinetics-400)
-                                   #   or videomae:ssv2
-
-# ---- streams & tokenizer geometry (small for a local GPU) ----
-# Stage-2 contract: >=1 video (rgb/tir) + >=1 1-D physio (bp/resp/eda).
-streams: tir,resp
-tir_channels: 3                    # thermal is a false-colour render, not gray
-tubelet: 2,16,16                   # first value MUST match the geometry below
-fs: 100.0                          # respiration is resampled 1000 -> 100 Hz
-fps: 25.0
-clip_duration: 8.0                 # 200 source frames @ 25 fps, decimated by
-                                   # temporal_stride 2 -> 100 frames -> 50
-                                   # temporal tubelets
-clip_stride: 1.0                   # window hop (seconds) -- 7/8 of consecutive
-                                   # windows OVERLAP, so the TRANSIENT breathing
-                                   # dynamics are sampled at 1 s resolution (a
-                                   # 4 s hop missed them). ~4x the clips (and
-                                   # epoch time) of 4.0. It defines WHICH
-                                   # windows exist -> keep it IDENTICAL in the
-                                   # Stage-3 sibling.
-temporal_stride: 2                 # decimate INSIDE the window (1=every frame;
-                                   # 2/4/8 -> 12.5/6.25/3.125 fps). NOT the
-                                   # window hop (that is clip_stride).
-                                   # REQUIRES sig_kernel 16 (see below) and is
-                                   # a DIFFERENT geometry: the video pos-embed
-                                   # token count halves (1600 -> 800), so a
-                                   # checkpoint from another stride cannot be
-                                   # loaded without re-init. Nyquist: 12.5 fps
-                                   # is ample for respiration (<1 Hz); bvp
-                                   # would need <=2.
-seq_len: 0                         # 0 => round(kept_seconds*fs) = 800 samples
-input_size: 64                     # ROI patch side after cv2.resize (16 px patches
-                                   # -> 4x4 spatial grid per frame). SMOKE SCALE:
-                                   #   production is 96 + padding 0.10 (see
-                                   #   configs/pretrain/stage2_hpc_tir_roi_resp
-                                   #   .yaml); keep this local Stage-2/Stage-3
-                                   #   pair in step with each other.
-roi_padding: 0.10                  # landmark-box margin added on EACH side. MUST
-                                   #   equal the HPC run: roi_padding is a frozen
-                                   #   CACHE KEY, so 0.20 would miss the shipped
-                                   #   cache and silently fall back to decoding.
-crop_rule: square                  # square the padded box BEFORE the rescale,
-                                   #   so ONE scale factor is applied (sx == sy)
-                                   #   and the anatomy is never deformed; 'box' is
-                                   #   the legacy per-axis geometry (A/B only)
-max_sway_px: 40                    # DROP a clip whose target-landmark centroid
-                                   #   travels further than this many source px
-                                   #   from its own within-clip median (0 = off)
-roi_landmarks: ''                  # '' = the historical 12-point nose+mouth set;
-                                   #   a preset (nose_mouth | nostrils |
-                                   #   nostril_mouth | nose_tip) or a CSV of
-                                   #   1-indexed labels. CHANGES THE VISUAL
-                                   #   INPUT -> a checkpoint trained with another
-                                   #   value must be re-pretrained. MEASURED:
-                                   #   'nostrils' is an unstable thin slab
-                                   #   (100x81 px still vs 91x15 px moving);
-                                   #   'nose_tip' is 36-70% smaller area and
-                                   #   stable -> prefer it for a ROI experiment.
-min_signal_spread: 0.1              # VOLTS: DROP a window whose spread
-                                   #   (max-min) is below this. 0.1 V catches the
-                                   #   DEAD-signal class a rail test cannot see:
-                                   #   a channel pinned just inside a clamp with
-                                   #   a 0.05-0.09 V ripple (median level +9.1 V).
