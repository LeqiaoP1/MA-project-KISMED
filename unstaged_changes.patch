-                                   #   clip whose window contains ANY sample that
-                                   #   touched the recorder rail (|x| >= 9.90;
-                                   #   the recorder clamps at +/-10 V). Both a
-                                   #   dead/pinned sensor and a clipped
-                                   #   flat-topped trough are removed, so no
-                                   #   rail-valued label survives. See
-                                   #   notes/eval/tir_resp/resp_data_quality.md
-                                   #   §3.4 + rail_forensics.py. Keep IDENTICAL
-                                   #   in Stage 2/3.
-                                   #   0.0 = off (the historical behaviour).
-# ---- space-time alignment (checked hard by the model) ----
-# tubelet_t*temporal_stride/fps == sig_kernel/fs -> 2*2/25 == 16/100 == 160 ms,
-# and 100/2 == 800/16 == 50 tokens per stream; the model raises otherwise.
-# RULE: sig_kernel = tubelet_t * temporal_stride / fps * fs. Raising
-# temporal_stride WITHOUT rescaling sig_kernel is the one way to break this
-# config, and the model refuses to build with an explicit recommendation.
-sig_kernel: 16
-pos_init: sincos3d                 # 3-D (t,h,w) sincos for video positions +
-                                   # the same 1-D temporal sincos for physio
-
-# ---- Solution A: asymmetric cross-MAE (the ONLY difference from Solution C) --
-# The encoder sees ONLY the video tokens; resp becomes a pure reconstruction
-# TARGET decoded by a cross-attention head. mask_ratio_resp below is therefore
-# UNUSED on this path (the loss covers EVERY time slot -- the Stage-3
-# "sensor fully absent" condition, trained directly).
